+            zmk_ble_profile_index(bt_conn_get_dst(conn)), info_err,
+            info_err ? -1 : (int)info.state, (unsigned int)bt_conn_get_security(conn),
+            bt_gatt_is_subscribed(conn, attr, BT_GATT_CCC_NOTIFY),
+            bt_gatt_attr_get_handle(attr), len, result);
